# Immich connection (required)
IMMICH_BASE_URL=http://localhost:2283/api
IMMICH_API_KEY=your-immich-api-key

# Optional additional headers sent with every request, as JSON.
# IMMICH_HEADERS={"X-Custom-Header":"value"}

# Transport: stdio | http | both  (default: stdio)
IMMICH_MCP_TRANSPORT=stdio

# HTTP transport options (used when transport is http/both)
IMMICH_MCP_HTTP_HOST=127.0.0.1
IMMICH_MCP_HTTP_PORT=3000
IMMICH_MCP_HTTP_PATH=/mcp

# Where downloaded/binary files are written
# IMMICH_MCP_DOWNLOAD_DIR=./downloads

# Maximum characters returned for a single tool result before truncation
# IMMICH_MCP_MAX_RESULT_CHARS=200000

# Tool filtering (comma separated)
# IMMICH_MCP_TAGS=Assets,Albums,People
# IMMICH_MCP_EXCLUDE_TAGS=Users (admin),Maintenance (admin)
# IMMICH_MCP_TOOLS=immich_search_assets,immich_get_album_info
# IMMICH_MCP_EXCLUDE_TOOLS=immich_delete_asset

# Only expose read-only (GET) operations
# IMMICH_MCP_READONLY=0
